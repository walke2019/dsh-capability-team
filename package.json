{
  "name": "@local/dsh-capability-team",
  "version": "3.1.4",
  "description": "DSH 能力协作团队预设：按能力映射模型、可对话配置、同档备选容灾",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "pretest": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs && node --test tests/global-memory/*.test.mjs && node --test tests/omni-search/*.test.mjs",
    "build:global-memory": "node packages/global-memory/scripts/build-shared.mjs",
    "build:omni-search": "node packages/omni-search/scripts/build-shared.mjs",
    "lint": "node scripts/check.mjs syntax",
    "build": "node scripts/check.mjs package"
  },
  "exports": {
    ".": "./ui.js",
    "./client": "./client.js",
    "./roles": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "roles.js",
    "config.js",
    "team.js",
    "failover.js",
    "defaults.js",
    "index.js",
    "free-worker.mjs",
    "integrations.js",
    "search.js",
    "search-engines.js",
    "transcribe.js",
    "task-bridge.js",
    "theme.js",
    "allocation.js",
    "theme-plugin.js",
    "tool-schema.js",
    "tool-names.js",
    "workflow.js",
    "opencode.js",
    "ui.js",
    "runtime-view.js",
    "model-policy.js",
    "access.js",
    "usage.js",
    "long-context.js",
    "plan-gate.js",
    "template.js",
    "config-projection.js",
    "session-policy.js",
    "request-evidence.js",
    "activity-summary.js",
    "observability-projection.js",
    "runtime-observability.js",
    "observability-api.js",
    "member-task-control.js",
    "task-control-audit.js",
    "task-control-api.js",
    "client.js",
    "client/*.js",
    "file-limits.js",
    "dispatch-confirm.js",
    "dispatch-routes-store.js",
    "session-rotation.js",
    "memory-embed.js",
    "memory-store.js",
    "memory-hub.js",
    "memory-openviking.js",
    "memory-backends.js",
    "preset-guard.js",
    "token-metrics.js",
    "memory-sync-queue.js",
    "memory-redact.js",
    "integrations-config.js",
    "http-guard.js",
    "model-prefs.js",
    "board-dispatch.js",
    "teammate-context.js",
    "token-discipline.js",
    "route-health.js",
    "skills/project-role-theme/SKILL.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "tests/*.test.mjs",
    "tests/fixture.mjs",
    "tests/helpers/*.mjs",
    "scripts/check.mjs",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
