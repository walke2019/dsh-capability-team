{
  "name": "@local/dsh-capability-team",
  "version": "3.0.0",
  "description": "DSH 能力协作团队预设：按能力映射模型、可对话配置、同档备选容灾",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/check.mjs syntax",
    "build": "node scripts/check.mjs package"
  },
  "exports": {
    ".": "./ui.js",
    "./client": "./client.js",
    "./roles": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "roles.js",
    "config.js",
    "team.js",
    "failover.js",
    "defaults.js",
    "index.js",
    "free-worker.mjs",
    "integrations.js",
    "search.js",
    "task-bridge.js",
    "theme.js",
    "allocation.js",
    "theme-plugin.js",
    "tool-schema.js",
    "workflow.js",
    "opencode.js",
    "ui.js",
    "runtime-view.js",
    "model-policy.js",
    "access.js",
    "usage.js",
    "long-context.js",
    "plan-gate.js",
    "template.js",
    "session-policy.js",
    "request-evidence.js",
    "client.js",
    "skills/project-role-theme/SKILL.md",
    "README.md",
    "LICENSE",
    "tests/*.test.mjs",
    "tests/fixture.mjs",
    "scripts/check.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
