{
  "name": "@aiwuk/team",
  "version": "5.0.7",
  "description": "AIWUK Team, a capability-routed multi-agent team preset for DeepSeek Harness (DSH) with per-role model routing, same-tier failover and conversational team configuration",
  "license": "MIT",
  "author": "walke2019",
  "homepage": "https://github.com/walke2019/dsh-capability-team#readme",
  "repository": { "type": "git", "url": "git+https://github.com/walke2019/dsh-capability-team.git" },
  "bugs": { "url": "https://github.com/walke2019/dsh-capability-team/issues" },
  "keywords": ["aiwuk", "dsh", "dsh-plugin", "deepseek-harness", "cordis", "agent-team", "multi-agent", "model-routing", "failover", "ai-agent", "llm"],
  "engines": { "node": ">=24.9", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-persona": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-experimental-agent-team": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent-preset": { "optional": true },
    "@deepseek-ai/dsh-persona": { "optional": true },
    "@deepseek-ai/dsh-experimental-agent-team": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-tool": { "optional": true },
    "@deepseek-ai/dsh-api-remotes": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar-right": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "type": "module",
  "scripts": {
    "build:client": "node shared-ui/build.mjs && node scripts/build-client.mjs",
    "pretest": "node shared-ui/build.mjs && node scripts/build-client.mjs",
    "test": "node --import ./tests/isolated-home.mjs --test tests/*.test.mjs && node --import ./tests/isolated-home.mjs --test tests/global-memory/*.test.mjs && node --import ./tests/isolated-home.mjs --test tests/omni-search/*.test.mjs && node --import ./tests/isolated-home.mjs --test tests/autocomplete/*.test.mjs",
    "build:global-memory": "node packages/global-memory/scripts/build-shared.mjs",
    "build:omni-search": "node packages/omni-search/scripts/build-shared.mjs",
    "build:autocomplete": "node packages/autocomplete/scripts/build-client.mjs",
    "lint": "node scripts/check.mjs syntax",
    "build": "node scripts/check.mjs package"
  },
  "exports": {
    ".": "./ui.js",
    "./client": "./client.js",
    "./roles": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./i18n/*.json": "./i18n/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "brand.js",
    "i18n.js",
    "roles.js",
    "member-models.js",
    "lead-route.js",
    "config.js",
    "roster-defaults.js",
    "single-model.js",
    "onboarding.js",
    "settings-schema.js",
    "team.js",
    "failover.js",
    "defaults.js",
    "index.js",
    "free-worker.mjs",
    "integrations.js",
    "search.js",
    "search-engines.js",
    "transcribe.js",
    "task-bridge.js",
    "theme.js",
    "allocation.js",
    "theme-plugin.js",
    "tool-schema.js",
    "tool-names.js",
    "workflow.js",
    "opencode.js",
    "ui.js",
    "runtime-view.js",
    "model-policy.js",
    "access.js",
    "teammate-wait.js",
    "usage.js",
    "long-context.js",
    "plan-gate.js",
    "template.js",
    "config-projection.js",
    "session-policy.js",
    "request-evidence.js",
    "activity-summary.js",
    "observability-projection.js",
    "runtime-observability.js",
    "observability-api.js",
    "member-task-control.js",
    "task-control-audit.js",
    "task-control-api.js",
    "client.js",
    "client/*.js",
    "file-limits.js",
    "dispatch-confirm.js",
    "dispatch-routes-store.js",
    "session-rotation.js",
    "memory-embed.js",
    "memory-store.js",
    "memory-hub.js",
    "memory-openviking.js",
    "memory-backends.js",
    "preset-guard.js",
    "token-metrics.js",
    "memory-sync-queue.js",
    "memory-redact.js",
    "integrations-config.js",
    "integrations-messages.js",
    "managed-resolve.js",
    "managed-ref.js",
    "managed-config-route.js",
    "shared/managed-config.js",
    "http-guard.js",
    "model-prefs.js",
    "board-dispatch.js",
    "teammate-context.js",
    "token-discipline.js",
    "route-health.js",
    "skills/project-role-theme/SKILL.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/memory-cli.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "i18n/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
