{
  "name": "@aiwuk/autocomplete",
  "version": "1.0.1",
  "type": "module",
  "description": "AIWUK Autocomplete, composer autocomplete for DeepSeek Harness (DSH) with inline continuation and next-message suggestions accepted with Tab, never sent automatically",
  "license": "MIT",
  "author": "walke2019",
  "homepage": "https://github.com/walke2019/dsh-capability-team/tree/main/packages/autocomplete#readme",
  "repository": { "type": "git", "url": "git+https://github.com/walke2019/dsh-capability-team.git", "directory": "packages/autocomplete" },
  "bugs": { "url": "https://github.com/walke2019/dsh-capability-team/issues" },
  "keywords": ["aiwuk", "dsh", "dsh-plugin", "deepseek-harness", "cordis", "autocomplete", "composer", "prediction", "llm"],
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.5" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true }
  },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./i18n/*.json": "./i18n/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "predictor.js", "schema.js", "fleet-defaults.js", "managed-route.js", "client.js", "cordis.patch.yml", "locale/*.json", "i18n/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "build": "node scripts/build-client.mjs", "test": "node --test ../../tests/autocomplete/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
