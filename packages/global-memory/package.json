{
  "name": "@aiwuk/memory",
  "version": "1.0.0",
  "type": "module",
  "description": "AIWUK Memory: profile-wide explicit memory tools and bounded automatic recall for DeepSeek Harness (DSH) sessions",
  "license": "MIT",
  "author": "walke2019",
  "homepage": "https://github.com/walke2019/dsh-capability-team/tree/main/packages/global-memory#readme",
  "repository": { "type": "git", "url": "git+https://github.com/walke2019/dsh-capability-team.git", "directory": "packages/global-memory" },
  "bugs": { "url": "https://github.com/walke2019/dsh-capability-team/issues" },
  "keywords": ["aiwuk", "dsh", "dsh-plugin", "deepseek-harness", "cordis", "memory", "recall", "bm25", "knowledge-base", "llm"],
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "peerDependencies": { "@deepseek-ai/cordis": ">=4.0.1", "@deepseek-ai/schemastery": ">=3.18.4" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true }, "@deepseek-ai/schemastery": { "optional": true } },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["*.js", "shared/**", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "build": "node scripts/build-shared.mjs", "test": "node --test ../../tests/global-memory/*.test.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-api-remotes"] } }
}
