{
  "name": "@aiwuk/search",
  "version": "1.0.0",
  "type": "module",
  "description": "AIWUK Search: profile-wide multi-engine web search, page fetch and user-approved audio transcription for DeepSeek Harness (DSH)",
  "license": "MIT",
  "author": "walke2019",
  "homepage": "https://github.com/walke2019/dsh-capability-team/tree/main/packages/omni-search#readme",
  "repository": { "type": "git", "url": "git+https://github.com/walke2019/dsh-capability-team.git", "directory": "packages/omni-search" },
  "bugs": { "url": "https://github.com/walke2019/dsh-capability-team/issues" },
  "keywords": ["aiwuk", "dsh", "dsh-plugin", "deepseek-harness", "cordis", "web-search", "web-fetch", "transcription", "tavily", "searxng", "llm"],
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "peerDependencies": { "@deepseek-ai/cordis": ">=4.0.1", "@deepseek-ai/schemastery": ">=3.18.4", "@deepseek-ai/dsh-web": ">=0.2.2-rc.1", "@deepseek-ai/dsh-experimental-speech-to-text": ">=0.2.2-rc.1" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true }, "@deepseek-ai/schemastery": { "optional": true }, "@deepseek-ai/dsh-web": { "optional": true }, "@deepseek-ai/dsh-experimental-speech-to-text": { "optional": true } },
  "exports": { ".": "./index.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "providers/**", "shared/**", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "build": "node scripts/build-shared.mjs", "test": "node --test ../../tests/omni-search/*.test.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
